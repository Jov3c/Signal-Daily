NODE_ENV=development
APP_TIMEZONE=Asia/Shanghai
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api

DATABASE_URL=mysql://signal:signal@localhost:3306/signal
REDIS_URL=redis://localhost:6379

# ⚠ 下面两个**只有 compose 形态用得到**（本地 pnpm dev 用上面的 DATABASE_URL）。
# `docker-compose.yml` 里是 `${MYSQL_PASSWORD:?}` —— **缺了就拒绝启动**，
# 不是「用默认值」。2026-10-01 实测 `docker compose config` 直接报：
#   required variable MYSQL_PASSWORD is missing a value
# 而当时这两个键在本文件里**根本不存在** —— 也就是说
# `cp .env.example .env && docker compose up -d --build` 这条写在
# `infra/nginx/README.md` 里的首次部署流程**走不通**。现补上。
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

AUTH_ACCESS_TOKEN_SECRET=change-me
AUTH_REFRESH_TOKEN_PEPPER=change-me
EMAIL_OTP_PEPPER=change-me

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback

MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_NOTIFICATION_EMAIL=

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

AI_DEFAULT_PROVIDER=openai-compatible
AI_DEFAULT_BASE_URL=
AI_DEFAULT_API_KEY=
AI_MODEL_CHEAP=
AI_MODEL_MEDIUM=
AI_MODEL_STRONG=
AI_DAILY_BUDGET_USD=5

X_API_BEARER_TOKEN=
GITHUB_TOKEN=

SOURCE_FETCH_MAX_BYTES=2097152
SOURCE_FETCH_TIMEOUT_MS=10000

LOG_LEVEL=info
SENTRY_DSN=
