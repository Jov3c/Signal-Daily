{
  "name": "@signal/api",
  "version": "0.1.0",
  "private": true,
  "description": "Signal API（NestJS）— Agent 00 只提供 bootstrap 空壳，业务模块由 Agent 02–11 填充。",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p test/tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -b && node dist/main.js",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "6.19.3",
    "@signal/config": "workspace:*",
    "@signal/contracts": "workspace:*",
    "@signal/logger": "workspace:*",
    "bullmq": "5.81.5",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/nodemailer": "^7.0.0"
  }
}
