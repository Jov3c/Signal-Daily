{
  "name": "signal",
  "version": "0.1.0",
  "private": true,
  "description": "Signal — 编辑型科技阅读平台 monorepo",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && pnpm --filter @signal/web run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.mts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsc -b prisma && node prisma/dist/seed.js",
    "db:studio": "prisma studio",
    "clean": "rimraf \"packages/*/dist\" \"apps/*/dist\" \"prisma/dist\" \"packages/*/*.tsbuildinfo\" \"apps/*/*.tsbuildinfo\" \"*.tsbuildinfo\"",
    "verify": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "prisma": {
    "seed": "tsc -b prisma && node prisma/dist/seed.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "prisma": "6.19.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  }
}
