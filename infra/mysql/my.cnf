# MySQL 生产参数 —— 只放 docs/16 明确要求的东西。
#
# FULLTEXT 的 parser 不在这里：它是索引属性，由 Agent 01 的第二个迁移
# （20260923170000_fulltext_ngram）在建索引时写进 DDL。docs/12 的中文搜索
# 依赖它，而 Prisma 的 @@fulltext 表达不了 parser —— 不要指望配置文件能修
# （Agent 01 的 P0 正是这个）。
[mysqld]
# docs/16：开 binlog（RPO <= 15min 靠「每日全量 + binlog 补齐」）
log-bin                    = /var/lib/mysql/mysql-bin
binlog-format              = ROW
binlog-expire-logs-seconds = 604800
server-id                  = 1
max-binlog-size            = 256M

# 时区：时间一律存 UTC（docs/01），业务日由应用按 Asia/Shanghai 换算。
# 不要设成 +08:00 —— 那会让 NOW() 与存储值出现 8 小时差
#（Agent 03 记录过本机 time_zone=SYSTEM=Asia/Shanghai 造成的静默事故）。
default-time-zone          = '+00:00'

# 字符集：utf8mb4（docs/03）。中文搜索与 emoji 都依赖它。
character-set-server       = utf8mb4
collation-server           = utf8mb4_0900_ai_ci

innodb_buffer_pool_size         = 512M
innodb_flush_log_at_trx_commit  = 1
# 死锁时不要只靠自动重试：应用层要把 P2034 当可重试
#（Agent 10 修 content-db 的偶发死锁时加了这条）。
innodb_deadlock_detect          = ON

[client]
default-character-set      = utf8mb4
